# Copy to .env and adjust. All variables are read by app/config.py (prefix FPL_).
FPL_DATABASE_URL=postgresql://fpl:fpl@localhost:5432/fpl
FPL_REDIS_URL=redis://localhost:6379/0

# Your FPL entry (team) id - optional for Phase 2, used to snapshot the public manager profile.
FPL_TEAM_ID=

# Enrichment adapters (optional). Odds are skipped when no key is configured.
FPL_ODDS_API_KEY=
FPL_ODDS_REGIONS=uk
FPL_UNDERSTAT_ENABLED=true

# HTTP behaviour
FPL_HTTP_TIMEOUT_SECONDS=20
FPL_HTTP_MAX_RETRIES=5
FPL_HISTORY_CONCURRENCY=6

# ---- Phase 5: autonomous execution (off until you arm it)
# Generate with: python -m app auth keygen
FPL_SECRET_KEY=
FPL_COMMIT_MINUTES_BEFORE=15
FPL_FINAL_LOCK_MINUTES_BEFORE=30
FPL_DRY_RUN_HOURS_BEFORE=24

# ---- Phase 6: control plane + alerts
# Required for PATCH /config, POST /execute/force and the dashboard kill switch.
FPL_API_TOKEN=
# WhatsApp alerts via CallMeBot (free, one-way): add +34 644 66 32 62 to your contacts, send it
# "I allow callmebot to send me messages", and it replies with your API key.
FPL_WHATSAPP_PHONE=
FPL_WHATSAPP_APIKEY=
# Telegram (optional, two-way with /killswitch): create a bot with @BotFather, send it a message, then read your chat id from
# https://api.telegram.org/bot<token>/getUpdates
FPL_TELEGRAM_BOT_TOKEN=
FPL_TELEGRAM_CHAT_ID=
# Optional generic webhook receiving {"text", "urgent"}
FPL_ALERT_WEBHOOK_URL=
